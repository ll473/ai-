APP_NAME=AI 智能商城
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=mysql+asyncmy://root:password@127.0.0.1:3306/ai_commerce?charset=utf8mb4
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Alibaba Cloud Model Studio OpenAI-compatible gateway (Beijing public endpoint).
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen3.7-plus
AI_EMBEDDING_MODEL=qwen3.7-text-embedding
AI_EMBEDDING_DIMENSIONS=1024

# Optional vector database. Business data always remains in MySQL.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=product_knowledge
RAG_SCORE_THRESHOLD=0.2
