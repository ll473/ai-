{
  "name": "ai-commerce-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:pages": "cross-env VITE_DEMO_MODE=true vue-tsc --noEmit && vite build --base=/ai-/",
    "test:unit": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.11.0",
    "dompurify": "^3.4.14",
    "element-plus": "^2.11.0",
    "marked": "^18.0.10",
    "pinia": "^3.0.3",
    "vue": "^3.5.20",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.6"
  }
}
